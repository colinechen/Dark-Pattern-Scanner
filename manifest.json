{
  "manifest_version": 3,
  "name": "Dark Pattern Scanner",
  "version": "0.0.7",
  "description": "Browsererweiterung zur Analyse von Dark Patterns – Bachelorarbeit",
  "action": {
    "default_title": "Dark Pattern Scanner öffnen"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "sidePanel", "storage"],
  "host_permissions": ["<all_urls>"]
}